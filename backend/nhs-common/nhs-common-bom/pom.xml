            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-redis</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- satoken -->
            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-satoken</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 安全模块 -->
            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-security</artifactId>
                <version>${revision}</version>
