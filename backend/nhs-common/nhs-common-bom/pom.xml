            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-mqtt</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ai模块 -->
            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-ai</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- mcp模块 -->
            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-mcp</artifactId>
                <version>${revision}</version>
            </dependency>

