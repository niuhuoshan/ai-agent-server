            </dependency>

            <!-- 数据库服务 -->
            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- OSS -->
            <dependency>
                <groupId>group.aitools.nhs</groupId>
