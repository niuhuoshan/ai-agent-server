            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-elasticsearch</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- web服务 -->
            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-web</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 翻译模块 -->
            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-translation</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 脱敏模块 -->
            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-sensitive</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 序列化模块 -->
            <dependency>
                <groupId>group.aitools.nhs</groupId>
                <artifactId>nhs-common-json</artifactId>
                <version>${revision}</version>
            </dependency>

